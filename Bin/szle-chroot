out() { printf "/bin/szle-chroot \n"; printf "%s\n" "$@"; }
ThrowWarn() { printf "/bin/szle-chroot\n"; printf "\033[0;33mWarn ==> $1\033[0m "; printf "\n"; } >&2
ThrowErr() { printf "/bin/szle-chroot\n"; printf "\033[0;31mErr ==> $1"; printf "\n"; } >&2
SelfKill() { ThrowErr "$@"; exit 1; }
